extends Node2D
## One actual GPU-rendered contact sheet: four headings x eight frozen run frames.
## This scene is generated by actor_acceptance; it never substitutes cached PNGs
## for the live actor or infers aesthetic approval from numeric checks.

const CharacterActor = preload("res://prototype/actors/character_actor.gd")
const DIRECTIONS := ["sw", "se", "nw", "ne"]
const DIRECTION_NAMES := ["西南", "東南", "西北", "東北"]
const VECTORS := [Vector2(-1, 1), Vector2(1, 1), Vector2(-1, -1), Vector2(1, -1)]

var gender := "male"
var loadout := {"clothing": "cloth", "armor": "chest", "weapon": "sword"}
var actors: Array[Node2D] = []
var font: Font


func _ready() -> void:
	font = load("res://assets/ui-font.otf")
	_label(("男性" if gender == "male" else "女性") + " · 跑步完整循環", Vector2(28, 20), 28, Color("e8ebe3"))
	_label("每列一個方向 · 由左至右為連續八格 · 角色由 Godot 實際繪製後停格", Vector2(30, 65), 16, Color("a1b8b7"))
	for frame in range(8):
		_label("第 %d 格" % (frame + 1), Vector2(122 + frame * 147, 106), 14, Color("dec291"))
	for row in range(4):
		_label(DIRECTION_NAMES[row], Vector2(25, 187 + row * 149), 15, Color("9dd7bb"))
		for frame in range(8):
			var actor: Node2D = CharacterActor.new()
			actor.name = "%s_%s_frame_%d" % [gender, DIRECTIONS[row], frame]
			actor.position = Vector2(153 + frame * 147, 265 + row * 149)
			actor.scale = Vector2.ONE * 1.85
			add_child(actor)
			actor.configure({"id": str(actor.name), "name": "跑步逐格檢視", "gender": gender, "loadout": loadout.duplicate()})
			actor.set_motion(VECTORS[row].normalized() * 56.0)
			actor.set_preview_frame(frame)
			actors.append(actor)
	_label("衣服＋胸甲＋佩劍  ｜  檢視肩肘連續性、擺臂、手腕、接縫、步幅與足點。", Vector2(29, 754), 15, Color("a1b8b7"))
	_label("新動作仍待使用者審美確認。", Vector2(960, 754), 14, Color("dec291"))


func get_frame_evidence() -> Array[Dictionary]:
	var evidence: Array[Dictionary] = []
	for index in range(actors.size()):
		evidence.append({"direction": DIRECTIONS[int(index / 8)], "requested_local_run_frame": index % 8, "state": actors[index].get_visual_state()})
	return evidence


func _label(text: String, position_value: Vector2, font_size: int, color: Color) -> void:
	var label := Label.new()
	label.text = text
	label.position = position_value
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	label.add_theme_font_override("font", font)
	label.add_theme_font_size_override("font_size", font_size)
	label.add_theme_color_override("font_color", color)
	add_child(label)


func _draw() -> void:
	draw_rect(Rect2(0, 0, 1280, 800), Color("0e191e"))
	draw_line(Vector2(28, 94), Vector2(1252, 94), Color("365055"), 1)
	for row in range(4):
		for frame in range(8):
			var card := Rect2(82 + frame * 147, 133 + row * 149, 140, 141)
			draw_rect(card, Color("172a30"))
			draw_rect(card, Color("334e51"), false, 1)
			var foot := Vector2(153 + frame * 147, 265 + row * 149)
			draw_line(foot + Vector2(-34, 0), foot + Vector2(34, 0), Color("496a67"), 1)
			draw_line(foot + Vector2(0, -3), foot + Vector2(0, 3), Color("84aca0"), 1)
